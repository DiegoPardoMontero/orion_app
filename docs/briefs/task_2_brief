# minutos inválidos → 400
curl -i -b /tmp/maria.txt -H "X-XSRF-TOKEN: $TOKEN" -H "Content-Type: application/json" \
  -d '{"weekday":2,"startTime":"09:30","endTime":"11:30"}' \
  http://localhost:8080/api/v1/me/availability/rules

# listar → incluye las de la semilla + la nueva del viernes
curl -b /tmp/maria.txt http://localhost:8080/api/v1/me/availability/rules
