# solape con la del lunes → 400
curl -i -b /tmp/maria.txt -H "X-XSRF-TOKEN: $TOKEN" -H "Content-Type: application/json" \
  -d '{"weekday":1,"startTime":"20:00","endTime":"22:00"}' \
